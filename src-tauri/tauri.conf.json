{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Downloader",
  "version": "0.1.2",
  "identifier": "ch.simone.videodownloader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Video Downloader",
        "width": 700,
        "height": 680,
        "minWidth": 600,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://i.ytimg.com data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "Scarica video e audio",
    "copyright": "Simone",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGRjQxMkIyMDJCQzMxMDUKUldRRk1id0NzaEwwWDZuTnM1ZXZtTzhjT3JBL3lkNC9IUllUeWlselBFcWNzdUJaeFZaeVR0bFUK",
      "endpoints": [
        "https://github.com/sim40702-debug/Video-Downloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
